[Defines]
  INF_VERSION                    = 0x0001001B
  BASE_NAME                      = AsanLib
  FILE_GUID                      = B72F8B4E-0B68-41C3-A244-826624565D0D
  MODULE_TYPE                    = BASE
  VERSION_STRING                 = 1.0
